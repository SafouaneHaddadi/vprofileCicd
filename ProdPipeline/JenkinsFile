def COLOR_MAP = [
    'SUCCESS': 'good', 
    'FAILURE': 'danger,'
]

pipeline {
    agent any

    environment {
        cluster = "vproappprod" 
        service = "vproappprodsvc" 
    }

    stages {
        stage('Deploy to prod ECS') {
        steps {
            //withAWS est une fonction fournie par le plugin AWS Steps qui permet d'utiliser des info d'identif° AWS spécifiées (dans ce cas, awscreds) pour authentifier les cmd AWS qui suivent.
            withAWS(credentials: 'awscreds', region: 'us-west-1') { //region: 'us-east-1' spécifie la région AWS où se trouve notre cluster ECS
            
            sh 'aws ecs update-service --cluster ${cluster} --service ${service} --force-new-deployment'
               }
        }
    }
    }
post {
    
    always {
        echo "Slack notifications"
        // Envoie une notification Slack
        slackSend(
            channel: '#',
            color: COLOR_MAP[currentBuild.currentResult],
            message: "*${currentBuild.currentResult}:* Job ${env.JOB_NAME} build ${env.BUILD_NUMBER} \n More info at: ${env.BUILD_URL}"
        )
    }
}

}
